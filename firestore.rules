rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents: only owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sessions: only owner can read and write
    match /sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // Messages subcollection: accessible only if parent session belongs to user
      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
      }

      // Summary subcollection: accessible only if parent session belongs to user
      match /summary/{summaryId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
        // User cannot overwrite/tamper with AI summaries directly; backend Admin SDK has full bypass
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
      }
    }
  }
}
