rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents: only owner can read and write, uid is immutable
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // Sessions: owner only, immutable uid & createdAt, server-controlled riskLevel/safety
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Creating session: must belong to current user, cannot self-set crisis or status
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && (!('riskLevel' in request.resource.data) || request.resource.data.riskLevel == 'none');

      // Updating session: owner only, cannot change uid or createdAt, cannot tamper with riskLevel
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('riskLevel' in request.resource.data) || request.resource.data.riskLevel == resource.data.riskLevel);

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Messages subcollection: accessible only if parent session belongs to user
      // Client writes cannot inject server safety flags (safetyFlag, crisisType)
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;

        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid
          && (!('safetyFlag' in request.resource.data) || request.resource.data.safetyFlag == false)
          && (!('crisisType' in request.resource.data) || request.resource.data.crisisType == null);

        allow update, delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
      }

      // Summary subcollection: accessible only if parent session belongs to user
      // Users cannot directly write or tamper with AI summaries (only backend Admin SDK writes summaries)
      match /summary/{summaryId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
